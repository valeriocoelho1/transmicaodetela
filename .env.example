# Development needs no environment variables: every setting has a default.

# --- Production (docker-compose.prod.yml on the VM) ---
# Copy this file to .env on the VM and replace every placeholder. Never commit .env.

# DNS name that points to the VM, without https:// (production: transmitirtela.com.br)
DOMAIN=SEU_DOMINIO

# Shared secret between the API and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=GERE_COM_openssl_rand_hex_32

# Public and private IPs of the VM (coturn --external-ip=PUBLIC/PRIVATE)
PUBLIC_IP=IP_PUBLICO_DA_VM
PRIVATE_IP=IP_PRIVADO_DA_VM

# Optional
MAX_VIEWERS_PER_ROOM=10

# Release being deployed (git tag without the leading v). Built images are tagged with it,
# so a rollback only needs the previous value and `up -d` without --build.
APP_VERSION=0.2.0
